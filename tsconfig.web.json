{
  "include": [
    "src/renderer/**/*",
    "src/preload/preload.d.ts",
    "forge.env.d.ts",
    "vite.renderer.config.mts",
    "packages/shared/src/i18n/types.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "google.maps"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/renderer/*"]
    }
  }
}
