# tests/providers reads these via dotenv (playwright.config.ts) and pushes
# them into the running app's settings through injectXxxProvider()
# (tests/helpers/settings-inject.ts) — which OVERWRITES whatever provider
# config is currently saved. Copy this to .env.test and fill in real keys;
# .env.test is gitignored. tests/api doesn't need any of these.

OPENAI_API_KEY=
CLAUDE_API_KEY=
GOOGLE_CLOUD=
BRAVE_API_KEY=
