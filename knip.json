{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/main/main.ts",
        "src/preload/preload.ts",
        "src/renderer/main.tsx",
        "forge.config.ts",
        "vite.main.config.mts",
        "vite.preload.config.mts",
        "vite.renderer.config.mts",
        "src/renderer/sub-apps/*/main.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "cmdk",
    "embla-carousel-react",
    "input-otp",
    "react-day-picker",
    "react-resizable-panels",
    "recharts",
    "shadcn",
    "tailwindcss",
    "tw-animate-css"
  ]
}
