{
  "name": "exodus",
  "version": "1.14.0",
  "private": true,
  "description": "ChatBot featuring MCP, Immersive Editor, RAG, AI Agents, Deep Research, and other modern capabilities.",
  "keywords": [],
  "homepage": "https://exodus.yancey.app",
  "license": "MIT",
  "author": {
    "name": "YanceyOfficial",
    "email": "yanceyofficial@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exodus-ai-org/exodus.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "STRIP_TEST_IDS=1 electron-forge make",
    "publish": "STRIP_TEST_IDS=1 electron-forge publish",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun run typecheck:node && bun run typecheck:web && bun run typecheck:shared",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:shared": "tsc --noEmit -p packages/shared/tsconfig.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "bun run scripts/i18n-check.ts",
    "i18n:status": "bun run scripts/i18n-status.ts",
    "knip": "knip",
    "prepare": "husky",
    "build:helper": "xcrun swiftc -O -o resources/bin/exodus-input helper-src/exodus-input/main.swift -target arm64-apple-macos13",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:electron": "electron-forge package && playwright test --project=e2e",
    "test:e2e:providers": "playwright test --project=providers",
    "db:generate": "drizzle-kit generate",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
