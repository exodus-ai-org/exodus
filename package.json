{
  "name": "exodus",
  "version": "1.14.0",
  "description": "ChatBot featuring MCP, Immersive Editor, RAG, AI Agents, Deep Research, and other modern capabilities.",
  "homepage": "https://exdous.yancey.app",
  "author": "Yancey Leo",
  "main": "./out/main/index.js",
  "scripts": {
    "asar:sniff": "npx tsx scripts/asar-sniff.ts",
    "icons": "node scripts/render-icons.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:helper": "swiftc -O -o resources/bin/exodus-input helper-src/exodus-input/main.swift -target arm64-apple-macos13",
    "build:linux": "cross-env STRIP_TEST_IDS=1 electron-vite build && electron-builder --linux",
    "build:mac": "pnpm build:helper && cross-env STRIP_TEST_IDS=1 electron-vite build && electron-builder --mac",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "cross-env STRIP_TEST_IDS=1 electron-vite build && electron-builder --win",
    "db:generate": "npx drizzle-kit generate",
    "dev": "electron-vite dev --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "postinstall": "electron-builder install-app-deps",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:electron": "playwright test --project=e2e",
    "test:e2e:providers": "playwright test --project=providers",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@elastic/elasticsearch": "^9.5.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgmq": "^0.0.6",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@googlemaps/places": "^3.0.0",
    "@hono/node-server": "^2.1.1",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.9",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "hono": "^4.13.7",
    "jszip": "^3.10.1",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "openai": "^7.10.0",
    "pdf-parse": "^2.4.5",
    "sucrase": "^3.35.1",
    "turndown": "^7.2.4",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "^4.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.63.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/google.maps": "^3.66.2",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.185.4",
    "@types/turndown": "^5.0.6",
    "@vis.gl/react-google-maps": "^1.10.0",
    "@vitejs/plugin-react": "^6.1.1",
    "change-case": "^5.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
