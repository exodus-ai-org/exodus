    "electron-vite": "^5.0.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.2.0",
    "husky": "^9.1.7",
    "immer": "^11.1.18",
    "input-otp": "^1.5.0",
    "jotai": "^2.20.3",
    "katex": "^0.18.6",
    "lint-staged": "^17.5.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.41.0",
    "markdown-it": "^15.0.1",
    "monaco-editor": "^0.56.0",
    "motion": "^13.2.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-day-picker": "10.0.1",
    "react-doctor": "^0.9.13",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.4.9",
    "react-resizable-panels": "^4.12.3",
    "react-router": "^8.3.1",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "semantic-release": "^25.0.9",
    "shadcn": "^4.21.0",
    "sileo": "^0.1.5",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
